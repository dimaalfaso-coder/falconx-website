---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/dm-sans/opsz.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'FalconX AI — IA que trabaja 24/7 por tu empresa',
  description = 'FalconX AI — Automatización de comunicación con IA para empresas. WhatsApp Business, redes sociales e integraciones a medida.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/assets/imagenes/og-falconx.jpg', Astro.site).href;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="FalconX AI">
  <meta property="og:locale" content="es_CL">
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="FalconX AI — IA que trabaja 24/7 por tu empresa">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImage}>
  <title>{title}</title>
  <link rel="icon" href="/assets/imagenes/logo-falconx.svg" type="image/svg+xml">
  <link rel="canonical" href={canonical}>
  <link rel="sitemap" href="/sitemap-index.xml">
</head>
<body>

<div class="aurora" aria-hidden="true">
  <div class="aurora-blob aurora-1"></div>
  <div class="aurora-blob aurora-2"></div>
  <div class="aurora-blob aurora-3"></div>
</div>

<slot />

</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
